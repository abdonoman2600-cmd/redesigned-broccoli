# Copy this file to `.env` for local work, or add the same names in your host's "Environment Variables" screen.
# NEVER commit the real values.

# REQUIRED — PostgreSQL connection string (Neon / Railway / Render / Supabase give you one).
# Example: postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=

# Owner account that is created automatically the first time the site runs on an EMPTY database.
# Set BOTH before the first visit, otherwise the built-in default owner (documented in the code) is used.
OWNER_EMAIL=
ADMIN_PASSWORD=

# Lets the owner reset a forgotten password from /admin/recover (12+ random characters).
ADMIN_RECOVERY_KEY=

# Public address of the store once you have a domain, e.g. https://rashid-decor.com (used in QR codes and links).
SITE_URL=

# Optional: a webhook that receives new-order / new-message alerts (Slack, Discord, Make, Zapier...).
NOTIFY_WEBHOOK_URL=
